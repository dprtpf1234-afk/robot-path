# Supabase (없으면 로컬 메모리 백엔드로 동작 — 개발 전용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 으로 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# entry key·관객 토큰 해시용 비밀값 (openssl rand -hex 32)
ENTRY_KEY_PEPPER=

# 로컬 메모리 모드 전용 (선택)
# DEV_TEACHERS=teacher@example.com:teacher1234
# DEV_AUTH_SECRET=
# 로컬에서 `next start`(프로덕션 모드)로 메모리 백엔드를 쓸 때만 1. 배포(Vercel)에서는 무시되고 항상 막힌다.
# ALLOW_MEMORY_BACKEND=1
